{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest",
          "/icons/**",
          "/favicon.ico",
          "/apple-touch-icon.png"
        ]
      }
    },
    {
      "name": "startup-images",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/splash/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/api/**"
  ]
}
